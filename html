  <script>
    function togglePlan(el) {
      document.querySelectorAll('.ptog').forEach(b => b.classList.remove('ptog-on'));
      el.classList.add('ptog-on');
    }
    document.querySelectorAll('.itab').forEach(t => {
      t.addEventListener('click', e => {
        e.preventDefault();
        document.querySelectorAll('.itab').forEach(x => x.classList.remove('itab-on'));
        t.classList.add('itab-on');
      });
    });
    document.querySelectorAll('.dt').forEach(t => {
      t.addEventListener('click', () => {
        document.querySelectorAll('.dt').forEach(x => x.classList.remove('dt-on'));
        t.classList.add('dt-on');
      });
    });
